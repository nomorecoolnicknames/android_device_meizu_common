         if (mFrameMetricsReporter != nullptr) {
             mFrameMetricsReporter->reportFrameMetrics(forthBehind->data(), true /*hasPresentTime*/,
                                                       frameNumber, surfaceControlId);
@@ -713,7 +709,7 @@ void CanvasContext::reportMetricsWithPresentTime() {
 }
 
